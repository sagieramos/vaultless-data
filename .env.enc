# vaultless-api .env
# Copy this to .env (or set env vars in your environment) and fill in secret values.
# Required: PASETO keys, DB_PASSWORD, API_KEY_SALT
# Optional: DATABASE_URL will override explicit DB_* fields if provided
# -----------------------------
# Server
# -----------------------------
SERVER_HOST=ENC[AES256_GCM,data:Fxr7d7D15Q==,iv:AxIMyu0dCm4+OQAtoJ5LPyJO/uMqq5crR+fOqsJS++M=,tag:k6M+RdT7kH9y6e8s9o3mnw==,type:str]
SERVER_PORT=ENC[AES256_GCM,data:tiWgng==,iv:0IPyXp9mIKiyw7j1irocYZCUQpx/VBh1mgvV6LlgvX8=,tag:AMrEFsJ+wwWIsQ/2uxephw==,type:str]
# Standard Rust log filter (default: info,vaultless_api=debug)
RUST_LOG=ENC[AES256_GCM,data:1CNujI7rlAcs7QfIuQ+KDzJxlZSryvhj,iv:IUhbpRJ9cUjPNG0rzclLJDFzj7G56zDwoRE0VEZ8clI=,tag:2gJwmVq0LebgMhoIyn/+gA==,type:str]
# -----------------------------
# PostgreSQL Database
# -----------------------------
# Note: when running with docker-compose, the `postgres` service uses
# POSTGRES_* defaults and a sample DATABASE_URL. For local docker dev
# you can use DB_HOST=postgres and DB_PASSWORD=vaultless_dev_pass.
DB_HOST=ENC[AES256_GCM,data:V6BcFtz8Pmqb,iv:/N1UBUaE5Z7EzoBBZ6M9MXHnUv6ZBOJIvcCidlQIc+4=,tag:blr+JcC4Zdq/UHY4xspcHA==,type:str]
DB_PORT=ENC[AES256_GCM,data:e+CN5g==,iv:x7TqHA+pRptuiXl3/Z9ZrbHuZYSoiwgpgaUrLsFaVJs=,tag:z+GubHTpezQdya/KDgXL0w==,type:str]
DB_NAME=ENC[AES256_GCM,data:m2SED+1vB0udeHdP,iv:rHrAHbrZ9eN6AZJHwK+shkSsvkwEm3VVJlZd9TLVeyA=,tag:yvpIKQ3AXM5b0dMXtLji6w==,type:str]
DB_USERNAME=ENC[AES256_GCM,data:OBHDQfW6QBdS,iv:W5jtwWftPN2rVXi3vbfXL6+onWLWewSG9YoSQpBRyf0=,tag:eytJtWO7msN7JfyjN7Gaew==,type:str]
# REQUIRED: set a strong DB password (docker-compose default: vaultless_dev_pass)
# Use development password that matches docker-compose postgres service
# For local docker-compose runs the default is `vaultless_dev_pass`.
DB_PASSWORD=ENC[AES256_GCM,data:9YdKKDJVUratvVCmKhWxHzvn,iv:1kI0YpW4KfaMjZT8sEzAVG8Qx+XNWzgsdogdftt3DOs=,tag:Qb+Ut3azRVNXetwc2Y9/rg==,type:str]
DB_MAX_CONNECTIONS=ENC[AES256_GCM,data:QSs=,iv:Q3D7oYqpLiuwl3ewWkPBp9b3ktmVBgLci+miiVbns84=,tag:c05A/p6zxqEB99YCtSD5PQ==,type:str]
# Optional SSL mode (disable|require|prefer)
DB_SSL_MODE=ENC[AES256_GCM,data:IXB9jfpJKw==,iv:eyrgrLft1GsDwE1XxIqnKlj6ziGTjxkIr5b/XQ4zNpQ=,tag:Vf0C0aBGRnHZGet2uFZG9Q==,type:str]
# Optional complete connection string (overrides explicit fields if set)
# Example docker-compose default:
# DATABASE_URL=postgres://vaultless:vaultless_dev_pass@localhost:5432/vaultless_db
DATABASE_URL=ENC[AES256_GCM,data:XLv+Ookggl6MzocZggRs+kqgCjps3y9u6x+uucUcL5ClpJOewb8z9dMNy0WbLlDPbYZ33rxkwPobdg3VNVy0nQau8qhz/+FDjVDH+12b3dkuQHk=,iv:Y+M9yzKv6ux0GKEho2x1C1fZIw74k47CPasJDtndDcY=,tag:bG3NqUpIJW+ltSWiAGY93w==,type:str]
# Docker / docker-compose helpers (used by the `postgres` service)
POSTGRES_USER=ENC[AES256_GCM,data:oIYnErGqr+jTDIAjfHQI1AtXxEyi1YKT3Q==,iv:rVGcBug7M0iLVMa7SyfTqol5o1EA5B9ylag7poBxBlA=,tag:rJZDs5I5zkoV2A05jGu4HQ==,type:str]
POSTGRES_PASSWORD=ENC[AES256_GCM,data:KiyFymgEyAtQiiuYsUkuFGh//g8XNKUGhlZZyvArpGxgHg==,iv:ADZr3HQio+i9bnH4jpa1i8b9wkPyxYW9Kh8ItBUzqbw=,tag:fq+D0lWWNpav2c6CAYm2XA==,type:str]
POSTGRES_DB=ENC[AES256_GCM,data:Q+/ysH2NKn8LcHsdO3zMBgJyVIw2nkf4,iv:3E+ZGyxyCN3Wlw0y5VCKAdcF8/8LNoba3QmTmsXJ5NQ=,tag:AtkLSEY5wBU3oFbmAm8rSQ==,type:str]
# When running services inside docker-compose, you may want to set:
# DB_HOST=postgres
# CACHE_HOST=dragonfly
# -----------------------------
# Cache (Redis / Dragonfly)
# -----------------------------
CACHE_HOST=ENC[AES256_GCM,data:lXy7BR55Lj5d,iv:bbe5OUE2iiG+I+nZ8JX/Ti4rGM+Jx4Snqhis4LruzzQ=,tag:LFW9Q+0oqMjoKYZR1pSjfg==,type:str]
CACHE_PORT=ENC[AES256_GCM,data:l1YmaA==,iv:6/2teWCtneDST/BUHEMTm4X0g8Kn//AewdCLijqDjkk=,tag:fJzAeyFeoxfYeT7LFaxf8g==,type:str]
# Optional password (leave empty if none)
CACHE_PASSWORD=
# Optional DB index (0 by default)
CACHE_DATABASE=ENC[AES256_GCM,data:dQ==,iv:g2123QjrbeT2P3i/pm4Y2THpTAypede03+LgXmAhVTA=,tag:Ho7K1E1CmIysfwpVjGoYGw==,type:str]
CACHE_MAX_POOL_SIZE=ENC[AES256_GCM,data:bJA=,iv:xIMtD7cNB0tFTug8TVr/2KsT/6urDfncrywGQqj8gZw=,tag:f1cmXIoUSIdMHcdovxrS+A==,type:str]
CACHE_DEFAULT_TTL=ENC[AES256_GCM,data:S2UL2g==,iv:O5w5/SjmOxPmWJtxAwEvkc6usR38l+O0L1ryg97mlpQ=,tag:2j1rsPSJcIRaRf+eb++aLw==,type:str]
# -----------------------------
# Security
# -----------------------------
# REQUIRED: a random salt used for hashing API keys. Use >=16 chars.
API_KEY_SALT=ENC[AES256_GCM,data:kzh1sjM7DhtBetnLyWlG0z8CxecX2OwQzSr7UvQrqcJL+zjklg==,iv:9l1XQiSn2cBtsb7B3y204xiWIIBW4Y6Bq71+waaouXc=,tag:XKjb+3WKliQaGD9XEw3cTw==,type:str]
# Optional admin API key for privileged operations
ADMIN_API_KEY=
# Rate limit per minute
RATE_LIMIT_PER_MINUTE=ENC[AES256_GCM,data:lwA=,iv:h4RuqZsgt7ilIrgt73V/XKE04yDBpeeSyn2Oc3Bj1+E=,tag:cq0Z9BPozemFtw3tsj2n4Q==,type:str]
# PASETO session keys (hex string). CURRENT is required; PREVIOUS is optional for rotation.
# Example: 64 hex chars (32 bytes) -> aabbcc... (don't use these example values in prod)
PASETO_CLIENT_SESSION_CURRENT_KEY=ENC[AES256_GCM,data:PKJcRfGjEsJAhIxR4pX/3JB5EhKoaWaAjEqJqU24cGR2tcdA0fvn+9TMpUKAGot4k1kYt7W8DV58IYjtgpxllg==,iv:IR08qKay0QKGR4UNcDQstzGxiqaZIHeLJL/G4OCMrxI=,tag:4bxg3O7/aPaNryeW3tn2og==,type:str]
PASETO_CLIENT_SESSION_PREVIOUS_KEY=ENC[AES256_GCM,data:CN8xcROwHhaCKSR/8BVa8MWZELKDsEBsSX8UfXRrwM3XjawJBS3urkWRkFNbQslYsGdNa1XTfTtPgaPde3h5aQ==,iv:aopiHMNeJjVNMA4KbPJDiZ79ACOztQ4Tsgyb7/R2WkA=,tag:UlvrU0dpSDJ+KcqlqCgZpg==,type:str]
# Whether to use secure cookies (true for production, false for development)
# For development, set to false to allow cookies over HTTP
SECURE_COOKIES=ENC[AES256_GCM,data:EfKlfxI=,iv:nBmzat8IhlhYka9RwAr2cjyPGfCyiA381nFftEsi3d4=,tag:Sdluk/WIQFQ4aTeJgdzGBw==,type:str]
