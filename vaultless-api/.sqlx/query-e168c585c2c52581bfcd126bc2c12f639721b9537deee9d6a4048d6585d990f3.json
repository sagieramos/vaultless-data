  "query": "\n            SELECT \n                application_id,\n                user_id,\n                name,\n                description,\n                is_active,\n                created_at,\n                updated_at,\n                max_ttl_seconds,\n                is_key_rotation_forced,\n                deletion_requested_at,\n                integrity_config,\n                publishable_keys,\n                publishable_key_count,\n                webhooks,\n                webhook_count,\n                COUNT(*) OVER() AS total_count\n            FROM mv_applications_with_usage\n            WHERE user_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
