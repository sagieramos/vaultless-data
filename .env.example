# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,vaultless_api=debug,vaultless_core=debug

# Database
DATABASE_URL=postgresql://vaultless:vaultless_dev_pass@localhost:5432/vaultless_db
DATABASE_MAX_CONNECTIONS=10

# Security
API_KEY_SALT=change-this-random-salt-in-production
RATE_LIMIT_PER_MINUTE=60

# Message Retention (in seconds)
MESSAGE_TTL_FREE=604800           # 7 days
MESSAGE_TTL_STARTER=2592000       # 30 days
MESSAGE_TTL_PRO=7776000           # 90 days
