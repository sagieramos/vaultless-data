# =============================================================================
# VAULTLESS API CONFIGURATION
# =============================================================================
# Copy this file to .env and update values for your environment.
# Required variables are marked with [REQUIRED].

# =============================================================================
# SERVER
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info,vaultless_api=debug,vaultless_core=debug

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vaultless_db
DB_USERNAME=vaultless
DB_PASSWORD=your_secure_password_here             # [REQUIRED] Change this!
DB_MAX_CONNECTIONS=10
# DB_SSL_MODE=require                             # Uncomment for production

# =============================================================================
# CACHE (Redis/Dragonfly)
# =============================================================================
CACHE_HOST=localhost
CACHE_PORT=6379
# CACHE_PASSWORD=your_redis_password              # Uncomment if Redis requires auth
# CACHE_DATABASE=0                                # Redis database index (0-15)
CACHE_MAX_POOL_SIZE=20
CACHE_DEFAULT_TTL=3600                            # 1 hour

# =============================================================================
# SECURITY
# =============================================================================
# [REQUIRED] Salt for hashing API keys - generate a random string for production!
# Example: openssl rand -hex 32
API_KEY_SALT=change-this-random-salt-in-production

# Admin API key for privileged operations (optional)
# ADMIN_API_KEY=your_admin_api_key

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# SESSION KEYS (PASETO)
# =============================================================================
# [REQUIRED] 64-character hex string (32 bytes) for PASETO session tokens
# Generate with: openssl rand -hex 32
PASETO_CLIENT_SESSION_CURRENT_KEY=your_64_character_hex_key_here

# Previous key for rotation (optional) - allows old tokens to remain valid during key rotation
# PASETO_CLIENT_SESSION_PREVIOUS_KEY=old_64_character_hex_key

# =============================================================================
# CRYPTOGRAPHIC KEYS
# =============================================================================
# Server private key for signing (64-character hex string)
# Generate with: openssl rand -hex 32
VAULTLESS_SERVER_PRIVATE_KEY=your_64_character_hex_key_here

# =============================================================================
# MESSAGE RETENTION (seconds)
# =============================================================================
MESSAGE_TTL_FREE=604800                           # 7 days
MESSAGE_TTL_STARTER=2592000                       # 30 days
MESSAGE_TTL_PRO=7776000                           # 90 days

# =============================================================================
# METRICS
# =============================================================================
METRICS_MAX_BATCH_SIZE=1000
METRICS_TTL_SECS=7200                             # 2 hours
METRICS_FLUSH_INTERVAL_SECS=60                    # 1 minute
METRICS_REDIS_TIMEOUT_SECS=30
