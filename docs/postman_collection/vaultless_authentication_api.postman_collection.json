//! # Usage Metrics Module
//!
//! This module provides functionality for tracking and aggregating usage metrics
//! for API keys in the Vaultless system. It supports high-throughput recording
//! of events (e.g., messages sent, received, proofs verified, rate limit hits)
//! with Redis for distributed, atomic counters and PostgreSQL for persistent
//! storage. Designed for scales up to 20k+ RPS, it uses Redis hashes for
//! per-hour aggregation and a background flusher for batched upserts to Postgres.
//!
//! ## Key Features
//! - **High-Throughput Recording**: Async Redis increments (`HINCRBY`) for sub-ms latency.
//! - **Batched Persistence**: Minutely flushes aggregate to Postgres via dynamic upserts.
//! - **Executor Compatibility**: All DB ops support `&PgPool` or `&mut Transaction`.
//! - **TTL Management**: Auto-expires Redis keys after 2 hours to prevent bloat.
//! - **Error Handling**: Maps Redis/Postgres errors to `VaultlessError::Internal`.
//!
//! 1. **Startup** (in `main.rs` or app init):
//!    ```rust
//!    use vaultless_core::models::usage::{create_redis_conn, start_redis_flusher, UsageMetric};
//!    use sqlx::PgPool;
//!
//!    #[tokio::main]
//!    async fn main() -> Result<(), Box<dyn std::error::Error>> {
//!        let redis_url = std::env::var("REDIS_URL").unwrap_or_else(|_| "redis://localhost:6379".to_string());
//!        let redis = create_redis_conn(&redis_url).await?;
//!        let pool = PgPool::connect(&std::env::var("DATABASE_URL")?).await?;
//!        let flush_interval_secs = 60;
//!
//!        // Spawn flusher
//!        start_redis_flusher(Arc::new(redis.clone()), pool.clone(), flush_interval_secs).await;
//!
//!        // Now use in handlers, e.g.:
//!        UsageMetric::record_message_sent(Arc::new(redis), pool.clone(), api_key_id, size_bytes).await?;
//!
//!        Ok(())
//!    }
//!    ```
//!
//! 2. **Configuration**:
//!    - Redis: Use Dragonfly for cost-effective scaling; set `maxmemory-policy allkeys-lru`.
//!    - Postgres: Ensure unique index on `(api_key_id, period_start)`; partition by `period_start` for >1M rows.
//!    - Tuning: Adjust flush interval (60s default) and SCAN count (100) based on key volume.
//!
//! ## Data Model
//! Metrics are hourly (`period_start` to `period_end`). Redis keys: `metric:hash:{api_key_id}:{YYYYMMDDHH}`.
//! Postgres table: `usage_metrics` with columns matching `UsageMetric`.
//!
//! ## Error Handling
//! All methods return `Result<_, VaultlessError>`. Redis/Postgres failures map to `Internal`.
//!
//! ## Performance Notes
//! - **20k RPS**: Redis handles ~100k HINCRBY/sec; flushes ~1k batches/min.
//! - **Monitoring**: Track Redis `HINCRBY` latency, Postgres upsert TPS, and key count (`INFO keyspace`).
//! - **Fallback**: On Redis outage, increments fail fast; consider circuit breakers (e.g., `tower`).

use chrono::TimeZone;
use chrono::{DateTime, Datelike, Duration as ChronoDuration, Timelike, Utc};
use redis::{AsyncCommands, RedisError, aio::ConnectionManager};
use serde::{Deserialize, Serialize};
use sqlx::{Executor, FromRow, PgPool, Postgres, query};
use std::collections::HashMap;
use std::sync::Arc;
use tokio::time::{Duration, interval};
use tracing::{error, info};
use uuid::Uuid;

use crate::error::{Result, VaultlessError};

// Redis connection type
pub type RedisConn = ConnectionManager;

/// Creates a new async Redis connection manager.
///
/// # Arguments
/// * `redis_url` - Redis server URL (e.g., "redis://localhost:6379").
///
/// # Errors
/// Returns `RedisError` if connection fails.
///
/// # Example
/// ```rust,no_run
/// let redis = create_redis_conn("redis://localhost:6379").await?;
/// ```
pub async fn create_redis_conn(redis_url: &str) -> Result<RedisConn> {
    let client =
        redis::Client::open(redis_url).map_err(|e| VaultlessError::Internal(e.to_string()))?;
    ConnectionManager::new(client)
        .await
        .map_err(|e| VaultlessError::Internal(e.to_string()))
}

/// Computes the start of the current hour (UTC) for metric bucketing.
fn get_period_start(now: &DateTime<Utc>) -> DateTime<Utc> {
    Utc.with_ymd_and_hms(now.year(), now.month(), now.day(), now.hour(), 0, 0)
        .unwrap()
}

/// Generates a Redis hash key for metrics.
fn hash_key(api_key_id: Uuid, period: &DateTime<Utc>) -> String {
    format!("metric:hash:{}:{}", api_key_id, period.format("%Y%m%d%H"))
}

/// Increments one or more Redis fields atomically (internal helper).
async fn hincr_many<C>(conn: &mut C, key: &str, fields: &[(&str, i64)], ttl_secs: i64) -> Result<()>
where
    C: AsyncCommands + Send + Unpin,
{
    for (field, value) in fields {
        conn.hincr::<_, _, _, i64>(key, field, *value)
            .await
            .map_err(|e| VaultlessError::Internal(e.to_string()))?;
    }

    conn.expire::<_, ()>(key, ttl_secs)
        .await
        .map_err(|e| VaultlessError::Internal(e.to_string()))?;

    Ok(())
}

/// Atomically increments message sent counters in Redis (HINCRBY).
///
/// # Arguments
/// * `redis` - Redis connection.
/// * `api_key_id` - The API key ID.
/// * `size_bytes` - Message size in bytes.
///
/// # Errors
/// Maps Redis errors to `VaultlessError::Internal`.
///
/// # Example
/// ```rust,no_run
/// increment_message_sent(&redis, api_key_id, 1024).await?;
/// ```

pub async fn increment_message_sent<C>(
    conn: &mut C,
    api_key_id: Uuid,
    size_bytes: i64,
) -> Result<()>
where
    C: AsyncCommands + Send + Unpin,
{
    let now = Utc::now();
    let key = hash_key(api_key_id, &get_period_start(&now));
    hincr_many(
        conn,
        &key,
        &[("messages_sent", 1), ("total_bytes_stored", size_bytes)],
        7200,
    )
    .await
}

/// Atomically increments message received counters in Redis (HINCRBY).
///
/// # Arguments
/// * `redis` - Redis connection.
/// * `api_key_id` - The API key ID.
///
/// # Errors
/// Maps Redis errors to `VaultlessError::Internal`.
pub async fn increment_message_received<C>(conn: &mut C, api_key_id: Uuid) -> Result<()>
where
    C: AsyncCommands + Send + Unpin,
{
    let key = hash_key(api_key_id, &get_period_start(&Utc::now()));
    hincr_many(conn, &key, &[("messages_received", 1)], 7200).await
}

/// Atomically increments proof verified counters in Redis (HINCRBY).
///
/// # Arguments
/// * `redis` - Redis connection.
/// * `api_key_id` - The API key ID.
///
/// # Errors
/// Maps Redis errors to `VaultlessError::Internal`.
pub async fn increment_proof_verified<C>(conn: &mut C, api_key_id: Uuid) -> Result<()>
where
    C: AsyncCommands + Send + Unpin,
{
    let key = hash_key(api_key_id, &get_period_start(&Utc::now()));
    hincr_many(conn, &key, &[("proofs_verified", 1)], 7200).await
}

/// Atomically increments rate limit hit counters in Redis (HINCRBY).
///
/// # Arguments
/// * `redis` - Redis connection.
/// * `api_key_id` - The API key ID.
///
/// # Errors
/// Maps Redis errors to `VaultlessError::Internal`.
pub async fn increment_rate_limit_hit<C>(conn: &mut C, api_key_id: Uuid) -> Result<()>
where
    C: AsyncCommands + Send + Unpin,
{
    let key = hash_key(api_key_id, &get_period_start(&Utc::now()));
    hincr_many(conn, &key, &[("rate_limit_hits", 1)], 7200).await
}

/// Starts the background flusher task for migrating Redis metrics to Postgres.
///
/// This function spawns a Tokio task that runs at intervals defined by the `flush_interval_secs`
/// parameter. It should be called once during application startup.
///
/// # Arguments
/// * `redis` - Shared Redis connection.
/// * `pg_pool` - Postgres pool for persistence.
/// * `flush_interval_secs` - Interval, in seconds, between each flush operation.
pub async fn start_redis_flusher(redis: Arc<RedisConn>, pg_pool: PgPool, flush_secs: u64) {
    let redis = Arc::clone(&redis);
    let pg_pool = Arc::new(pg_pool);

    tokio::spawn(async move {
        let mut ticker = interval(Duration::from_secs(flush_secs));
        loop {
            ticker.tick().await;
            if let Err(e) = flush_redis_to_pg(&redis, &pg_pool).await {
                error!(?e, "Redis → Postgres metrics flush failed");
            }
        }
    });
}

/// Flushes aggregated metrics from Redis to Postgres (internal; called by flusher).
///
/// Scans Redis for `metric:hash:*` keys, aggregates values, performs batched upserts,
/// and deletes flushed keys.
///
/// # Arguments
/// * `redis` - Redis connection.
/// * `pg` - Postgres pool.
///
/// # Errors
/// Maps errors to `VaultlessError::Internal`.
async fn flush_redis_to_pg(redis: &Arc<RedisConn>, pg: &Arc<PgPool>) -> Result<()> {
    let mut conn = redis.as_ref().clone();
    let mut cursor = 0u32;
    let mut batch: HashMap<(Uuid, DateTime<Utc>), MetricCounters> = HashMap::new();
    let mut keys_to_delete = Vec::new();

    loop {
        let (next, keys): (u32, Vec<String>) = redis::cmd("SCAN")
            .arg(cursor)
            .arg("MATCH")
            .arg("metric:hash:*")
            .arg("COUNT")
            .arg(200)
            .query_async(&mut conn)
            .await
            .map_err(|e| VaultlessError::Internal(e.to_string()))?;

        cursor = next;

        for key in keys {
            if let Some((api_key_id, period)) = parse_hash_key(&key) {
                let values: HashMap<String, i64> = conn
                    .hgetall(&key)
                    .await
                    .map_err(|e| VaultlessError::Internal(e.to_string()))?;

                let counters = batch
                    .entry((api_key_id, period))
                    .or_insert_with(MetricCounters::default);

                counters.merge_from_map(&values);
                keys_to_delete.push(key);
            }
        }

        if cursor == 0 {
            break;
        }
    }

    if batch.is_empty() {
        return Ok(());
    }

    let mut tx = pg.begin().await?;
    for ((api_key_id, period_start), counters) in batch {
        if counters.is_zero() {
            continue;
        }

        let period_end = period_start + ChronoDuration::hours(1);
        sqlx::query(
            r#"
            INSERT INTO usage_metrics (
                api_key_id, period_start, period_end,
                messages_sent, messages_received, proofs_verified,
                total_bytes_stored, rate_limit_hits
            )
            VALUES ($1,$2,$3,$4,$5,$6,$7,$8)
            ON CONFLICT (api_key_id, period_start)
            DO UPDATE SET
                messages_sent = usage_metrics.messages_sent + EXCLUDED.messages_sent,
                messages_received = usage_metrics.messages_received + EXCLUDED.messages_received,
                proofs_verified = usage_metrics.proofs_verified + EXCLUDED.proofs_verified,
                total_bytes_stored = usage_metrics.total_bytes_stored + EXCLUDED.total_bytes_stored,
                rate_limit_hits = usage_metrics.rate_limit_hits + EXCLUDED.rate_limit_hits
            "#,
        )
        .bind(api_key_id)
        .bind(period_start)
        .bind(period_end)
        .bind(counters.messages_sent as i32)
        .bind(counters.messages_received as i32)
        .bind(counters.proofs_verified as i32)
        .bind(counters.total_bytes_stored)
        .bind(counters.rate_limit_hits as i32)
        .execute(&mut *tx)
        .await?;
    }

    tx.commit().await?;

    // Fire-and-forget deletes (non-critical)
    for key in &keys_to_delete {
        let _ = conn.del::<_, ()>(key).await;
    }

    info!(
        "Flushed {} metric buckets to Postgres",
        keys_to_delete.len()
    );
    Ok(())
}

/// Parses a Redis hash key back to (api_key_id, period_start).
///
/// # Arguments
/// * `key` - The Redis key string (e.g., "metric:hash:uuid:2025102514").
///
/// # Returns
/// `Some((Uuid, DateTime<Utc>))` if valid, else `None`.
fn parse_hash_key(key: &str) -> Option<(Uuid, DateTime<Utc>)> {
    if let Some(parts) = key.strip_prefix("metric:hash:") {
        let segments: Vec<&str> = parts.split(':').collect();
        if segments.len() == 2 {
            if let (Ok(uuid), Some(ts_str)) = (Uuid::parse_str(segments[0]), {
                let s = segments[1];
                if s.len() == 10 {
                    // YYYYMMDDHH
                    let year = &s[0..4];
                    let month = &s[4..6];
                    let day = &s[6..8];
                    let hour = &s[8..10];

                    chrono::NaiveDateTime::parse_from_str(
                        &format!("{year}-{month}-{day} {hour}:00:00"),
                        "%Y-%m-%d %H:%M:%S",
                    )
                    .ok()
                } else {
                    None
                }
            }) {
                return Some((uuid, ts_str.and_utc()));
            }
        }
    }
    None
}

/// Temporary in-memory counters struct for aggregation during flush.
#[derive(Debug, Default, Clone)]
pub struct MetricCounters {
    pub messages_sent: i64,
    pub messages_received: i64,
    pub proofs_verified: i64,
    pub total_bytes_stored: i64,
    pub rate_limit_hits: i64,
}

impl MetricCounters {
    /// Checks if all counters are zero (skip flush).
    fn is_zero(&self) -> bool {
        self.messages_sent == 0
            && self.messages_received == 0
            && self.proofs_verified == 0
            && self.total_bytes_stored == 0
            && self.rate_limit_hits == 0
    }
}

/// Represents a single hourly usage metric record.
#[derive(Debug, Clone, FromRow, Serialize, Deserialize)]
pub struct UsageMetric {
    pub id: Uuid,
    pub api_key_id: Uuid,
    pub period_start: DateTime<Utc>,
    pub period_end: DateTime<Utc>,
    pub messages_sent: i32,
    pub messages_received: i32,
    pub proofs_verified: i32,
    pub total_bytes_stored: i64,
    pub rate_limit_hits: i32,
    pub estimated_cost_cents: Option<i32>,
    pub created_at: DateTime<Utc>,
}

/// Aggregated usage summary over a range.
#[derive(Debug, Clone, FromRow, Serialize)]
pub struct UsageSummary {
    pub api_key_id: Uuid,
    pub total_messages_sent: i64,
    pub total_messages_received: i64,
    pub total_proofs_verified: i64,
    pub total_bytes_stored: i64,
    pub total_rate_limit_hits: i64,
    pub total_cost_cents: i64,
    pub period_start: DateTime<Utc>,
    pub period_end: DateTime<Utc>,
}

impl UsageMetric {
    /// Records a message sent event (increments Redis counters).
    ///
    /// # Arguments
    /// * `redis` - Shared Redis connection.
    /// * `executor` - Postgres executor (unused here; for consistency).
    /// * `api_key_id` - The API key ID.
    /// * `size_bytes` - Message size.
    ///
    /// # Example
    /// ```rust,no_run
    /// UsageMetric::record_message_sent(redis, pool, api_key_id, 1024).await?;
    /// ```
    pub async fn record_message_sent<'c, E>(
        redis: Arc<RedisConn>,
        api_key_id: Uuid,
        size_bytes: i64,
    ) -> Result<()> {
        let mut m = redis.as_ref().clone();
        increment_message_sent(&mut m, api_key_id, size_bytes).await?;
        Ok(())
    }
    /// Records a message received event (increments Redis counters).
    ///
    /// # Arguments
    /// * `redis` - Shared Redis connection.
    /// * `executor` - Postgres executor.
    /// * `api_key_id` - The API key ID.
    pub async fn record_message_received<'c, E>(
        redis: Arc<RedisConn>,
        api_key_id: Uuid,
    ) -> Result<()>
    where
        E: Executor<'c, Database = Postgres>,
    {
        let mut m = redis.as_ref().clone();
        increment_message_received(&mut m, api_key_id).await?;
        Ok(())
    }
    /// Records a proof verification event (increments Redis counters).
    ///
    /// # Arguments
    /// * `redis` - Shared Redis connection.
    /// * `executor` - Postgres executor.
    /// * `api_key_id` - The API key ID.
    pub async fn record_proof_verified<'c, E>(
        redis: Arc<RedisConn>,
        api_key_id: Uuid,
    ) -> Result<()> {
        let mut m = redis.as_ref().clone();
        increment_proof_verified(&mut m, api_key_id).await?;
        Ok(())
    }
    /// Records a rate limit hit event (increments Redis counters).
    ///
    /// # Arguments
    /// * `redis` - Shared Redis connection.
    /// * `executor` - Postgres executor.
    /// * `api_key_id` - The API key ID.
    pub async fn record_rate_limit_hit<'c, E>(
        redis: Arc<RedisConn>,
        api_key_id: Uuid,
    ) -> Result<()> {
        let mut m = redis.as_ref().clone(); // Clone ConnectionManager (cheap, shares client)
        increment_rate_limit_hit(&mut m, api_key_id).await?;
        Ok(())
    }

    /// Fetches aggregated usage summary for a date range.
    ///
    /// # Arguments
    /// * `executor` - Postgres executor.
    /// * `api_key_id` - The API key ID.
    /// * `start` - Period start (UTC).
    /// * `end` - Period end (UTC).
    ///
    /// # Returns
    /// `UsageSummary` with summed metrics.
    ///
    /// # Example
    /// ```rust,no_run
    /// let summary = UsageMetric::get_summary(&pool, api_key_id, start, end).await?;
    /// ```
    pub async fn get_summary<'c, E>(
        executor: E,
        api_key_id: Uuid,
        start: DateTime<Utc>,
        end: DateTime<Utc>,
    ) -> Result<UsageSummary>
    where
        E: Executor<'c, Database = Postgres>,
    {
        let summary = sqlx::query_as::<_, UsageSummary>(
            r#"
            SELECT 
                $1 as api_key_id,
                COALESCE(SUM(messages_sent), 0) as total_messages_sent,
                COALESCE(SUM(messages_received), 0) as total_messages_received,
                COALESCE(SUM(proofs_verified), 0) as total_proofs_verified,
                COALESCE(SUM(total_bytes_stored), 0) as total_bytes_stored,
                COALESCE(SUM(rate_limit_hits), 0) as total_rate_limit_hits,
                COALESCE(SUM(estimated_cost_cents), 0) as total_cost_cents,
                $2 as period_start,
                $3 as period_end
            FROM usage_metrics
            WHERE api_key_id = $1
                AND period_start >= $2
                AND period_end <= $3
            "#,
        )
        .bind(api_key_id)
        .bind(start)
        .bind(end)
        .fetch_one(executor)
        .await?;

        Ok(summary)
    }

    /// Fetches current month's usage summary.
    ///
    /// # Arguments
    /// * `executor` - Postgres executor.
    /// * `api_key_id` - The API key ID.
    ///
    /// # Example
    /// ```rust,no_run
    /// let monthly = UsageMetric::get_current_month_usage(&pool, api_key_id).await?;
    /// ```
    pub async fn get_current_month_usage<'c, E>(
        executor: E,
        api_key_id: Uuid,
    ) -> Result<UsageSummary>
    where
        E: Executor<'c, Database = Postgres>,
    {
        let now = Utc::now();
        let month_start = now
            .date_naive()
            .with_day(1)
            .unwrap()
            .and_hms_opt(0, 0, 0)
            .unwrap()
            .and_utc();

        Self::get_summary(executor, api_key_id, month_start, now).await
    }

    /// Lists hourly metrics for an API key with pagination.
    ///
    /// # Arguments
    /// * `executor` - Postgres executor.
    /// * `api_key_id` - The API key ID.
    /// * `limit` - Max rows (e.g., 50).
    /// * `offset` - Skip rows (e.g., for page 2: 50).
    ///
    /// # Example
    /// ```rust,no_run
    /// let metrics = UsageMetric::list_for_api_key(&pool, api_key_id, 20, 0).await?;
    /// ```
    pub async fn list_for_api_key<'c, E>(
        executor: E,
        api_key_id: Uuid,
        limit: i64,
        offset: i64,
    ) -> Result<Vec<Self>>
    where
        E: Executor<'c, Database = Postgres>,
    {
        let metrics = sqlx::query_as::<_, Self>(
            r#"
            SELECT * FROM usage_metrics 
            WHERE api_key_id = $1
            ORDER BY period_start DESC
            LIMIT $2 OFFSET $3
            "#,
        )
        .bind(api_key_id)
        .bind(limit)
        .bind(offset)
        .fetch_all(executor)
        .await?;

        Ok(metrics)
    }

    /// Calculates estimated cost for current month based on usage and rates.
    ///
    /// # Arguments
    /// * `executor` - Postgres executor.
    /// * `api_key_id` - The API key ID.
    /// * `cost_per_message_cents` - Cost per message (f64).
    /// * `cost_per_gb_cents` - Cost per GB stored (f64).
    /// * `cost_per_verification_cents` - Cost per proof verification (f64).
    ///
    /// # Returns
    /// Total cost in cents (i32).
    ///
    /// # Example
    /// ```rust,no_run
    /// let cost = UsageMetric::calculate_cost(&pool, api_key_id, 0.01, 5.0, 0.005).await?;
    /// ```
    pub async fn calculate_cost<'c, E>(
        executor: E,
        api_key_id: Uuid,
        cost_per_message_cents: f64,
        cost_per_gb_cents: f64,
        cost_per_verification_cents: f64,
    ) -> Result<i32>
    where
        E: Executor<'c, Database = Postgres>,
    {
        let summary = Self::get_current_month_usage(executor, api_key_id).await?;

        let message_cost = summary.total_messages_sent as f64 * cost_per_message_cents;
        let storage_cost =
            (summary.total_bytes_stored as f64 / 1_073_741_824.0) * cost_per_gb_cents;
        let verification_cost = summary.total_proofs_verified as f64 * cost_per_verification_cents;

        let total_cost_cents = (message_cost + storage_cost + verification_cost) as i32;

        Ok(total_cost_cents)
    }
}

